    {
      "number": 4,
      "title": "Section4 急救措施",
      "groups": [
        {
          "parent": "(节下)",
          "anchor": false,
          "note": false,
          "fields": [
            {
              "label": "一般措施",
              "type": "field",
              "value": "立即脱掉所有被污染的衣物。",
              "matched": true
            },
            {
              "label": "误服",
              "type": "field",
              "value": "若意外吞食，不要催吐，立即就医。无意识时，不要经口喂食任何食物。",
              "matched": true
            },
            {
              "label": "接触眼睛",
              "type": "field",
              "value": "立即翻起上下眼睑用大量缓和流动的水清洗眼睛至少20 分钟。且将头倾斜，避免化学品流入另一只未受污染的眼睛，并立即就医。",
              "matched": true
            },
            {
              "label": "接触皮肤",
              "type": "field",
              "value": "立即用肥皂和大量的水冲洗。若发生皮肤反应，就医。",
              "matched": true
            },
            {
              "label": "吸入",
              "type": "field",
              "value": "一旦吸入，如有不适，就医。",
              "matched": true
            }
          ]
        }
      ]
    },
